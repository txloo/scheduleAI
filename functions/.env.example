# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# The .env file is loaded automatically by the Firebase emulator.
# For production, set these via:
#   firebase functions:config:set \
#     TELEGRAM_BOT_TOKEN="your_token" \
#     LLM_API_KEY="your_key" \
#     LLM_PROVIDER="openrouter" \
#     LLM_MODEL="z-ai/glm-5.2:free"

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
LLM_PROVIDER=openrouter
LLM_MODEL=z-ai/glm-5.2:free
LLM_API_KEY=sk-or-your-api-key-here
# 429 rate-limit retries (OpenRouter only, server-side setting): retry up to this many times before
# reporting failure to the user. Backoff: the provider's Retry-After header if present, else fixed 2s.
OPENROUTER_MAX_RETRIES=5
# Tool-calling mode (user-set option — no auto-detection): text | native (default native)
#   native — send the registered-API `tools` parameter (requires a tool-capable model/endpoint).
#   text   — provider workaround for models WITHOUT native tool support (e.g. OpenRouter `:free`
#            returns 404 "No endpoints found that support tool use" on `tools`): the native `tools`
#            param is omitted and a fenced-JSON tool-call protocol is appended to the system prompt
#            at request time only; tool calls are then parsed and executed backend-side.
# Text mode is a PROVIDER WORKAROUND: the base prompts stay unchanged; the switch is per-deployment via this
# env var (set LLM_TOOLS=text if your model has no native tool support).
# Models can be switched at runtime per user via the /model-<model-id> chat command.
# Provider calls are isolated in provider modules (e.g. openrouter.js); add a new
# module + LLM_PROVIDERS entry in index.js to support another provider.